# Production Environment Template for Starehe Girls' Centre (sgc.kkdes.co.ke)
# Copy to .env and populate secrets before starting Docker Compose.

DOMAIN=sgc.kkdes.co.ke
NEXT_PUBLIC_SITE_URL=https://sgc.kkdes.co.ke
NODE_ENV=production
PORT=3000
COOKIE_SECURE=true

# Admin account seeded on first boot (leave empty after initial setup if desired)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
